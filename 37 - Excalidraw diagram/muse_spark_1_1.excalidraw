      "lineHeight": 1.25
    },
    {
      "id": "DC1d6aFG",
      "type": "text",
      "x": 120,
      "y": 600,
      "width": 1400,
      "height": 120,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 301189087,
      "version": 1,
      "versionNonce": 1396950692,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Watashi wa  | kinou      | resutoran de | sushi o | tabeta\nI / TOPIC   | yesterday  | restaurant at| sushi OBJ| ate\nAs for me, | (time)     | (place)      | (object)| [PAST]\n-> Flexible order before verb, but Time -> Place -> Object is natural",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Watashi wa  | kinou      | resutoran de | sushi o | tabeta\nI / TOPIC   | yesterday  | restaurant at| sushi OBJ| ate\nAs for me, | (time)     | (place)      | (object)| [PAST]\n-> Flexible order before verb, but Time -> Place -> Object is natural",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6BVK0pms",
      "type": "text",
      "x": 120,
      "y": 760,
      "width": 1400,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 782619437,
      "version": 1,
      "versionNonce": 447082554,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "KEY INSIGHTS:\n* wa = Topic (what we're talking about)  |  ga = Subject (who does it)\n* No plurals, no articles, no gender - particles do the work\n* Topic can be dropped if obvious: (watashi wa) sushi o tabeta",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "KEY INSIGHTS:\n* wa = Topic (what we're talking about)  |  ga = Subject (who does it)\n* No plurals, no articles, no gender - particles do the work\n* Topic can be dropped if obvious: (watashi wa) sushi o tabeta",
      "autoResize": true,
      "lineHeight": 1.25
    },
