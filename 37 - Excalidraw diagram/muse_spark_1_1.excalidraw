      "roundness": null,
      "seed": 788513896,
      "version": 1,
      "versionNonce": 1943025407,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "TRANSLATION: As for me, yesterday with family, to Tokyo, delicious sushi, did (you) eat? (polite)\n= Did you eat delicious sushi in Tokyo with family yesterday?\n\nRULES:\n* Any block before VERB can be dropped if obvious\n* Natural order: Time > Place > With whom > Object > Verb, but flexible\n* Question = add ka at end, no word order change!\n* Negative = change verb ending: tabemasu -> tabemasen",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TRANSLATION: As for me, yesterday with family, to Tokyo, delicious sushi, did (you) eat? (polite)\n= Did you eat delicious sushi in Tokyo with family yesterday?\n\nRULES:\n* Any block before VERB can be dropped if obvious\n* Natural order: Time > Place > With whom > Object > Verb, but flexible\n* Question = add ka at end, no word order change!\n* Negative = change verb ending: tabemasu -> tabemasen",
      "autoResize": true,
      "lineHeight": 1.25
    },
