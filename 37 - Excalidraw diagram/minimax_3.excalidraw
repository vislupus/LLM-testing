      "text": "Adjective Conjugation — i-adjectives & na-adjectives",
      "fontSize": 32,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 29,
      "containerId": null,
      "originalText": "Adjective Conjugation — i-adjectives & na-adjectives",
      "lineHeight": 1.25
    },
    {
      "id": "el-237",
      "type": "text",
      "x": 60,
      "y": 2410,
      "width": 2280,
      "height": 40,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
