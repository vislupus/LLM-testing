      "versionNonce": 100473,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784969881135,
      "link": null,
      "locked": false,
      "text": "Japanese has two adjective types. i-adjectives end in い. na-adjectives need な before nouns.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 18,
      "containerId": null,
      "originalText": "Japanese has two adjective types. i-adjectives end in い. na-adjectives need な before nouns.",
      "lineHeight": 1.25
    },
