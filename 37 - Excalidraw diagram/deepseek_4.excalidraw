      "locked": false,
      "text": "📕 い-ADJECTIVES (形容詞)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "📕 い-ADJECTIVES (形容詞)",
      "lineHeight": 1.25
    },
    {
      "id": "adj-i-content",
      "type": "text",
      "x": 1030,
      "y": 592,
      "width": 400,
      "height": 115,
      "angle": 0,
      "strokeColor": "#4a148c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 63,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "End in 〜い (intrinsic)\nExample: 高い (たかい) = tall/expensive\n\nPlain present:  高い\nPlain past:     高かった\nPlain negative:  高くない\nPlain neg. past: 高くなかった\n\nPolite: 高いです・高かったです\nて-form: 高くて (links clauses)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "End in 〜い (intrinsic)\nExample: 高い (たかい) = tall/expensive\n\nPlain present:  高い\nPlain past:     高かった\nPlain negative:  高くない\nPlain neg. past: 高くなかった\n\nPolite: 高いです・高かったです\nて-form: 高くて (links clauses)",
      "lineHeight": 1.25
    },
