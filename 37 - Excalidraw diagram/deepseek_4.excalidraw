      "updated": 1,
      "link": null,
      "locked": false,
      "text": "🟣 HUMBLE (謙譲語) — Lower yourself",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟣 HUMBLE (謙譲語) — Lower yourself",
      "lineHeight": 1.25
    },
    {
      "id": "polite-kenjougo-content",
      "type": "text",
      "x": 1470,
      "y": 1032,
      "width": 440,
      "height": 65,
      "angle": 0,
      "strokeColor": "#b71c1c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 83,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• お/ご〜する: お持ちします\n• Special verbs: 食べる→いただく, 言う→申す\n• Used for YOUR actions toward superiors\n• いただく = humble receive (key word!)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• お/ご〜する: お持ちします\n• Special verbs: 食べる→いただく, 言う→申す\n• Used for YOUR actions toward superiors\n• いただく = humble receive (key word!)",
      "lineHeight": 1.25
    },
    {
      "id": "polite-scale",
      "type": "rectangle",
      "x": 60,
      "y": 1130,
      "width": 1870,
      "height": 110,
