      "text": "🟡 CASUAL / PLAIN (くだけた言い方)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟡 CASUAL / PLAIN (くだけた言い方)",
      "lineHeight": 1.25
    },
    {
      "id": "polite-casual-content",
      "type": "text",
      "x": 80,
      "y": 1032,
      "width": 380,
      "height": 65,
      "angle": 0,
      "strokeColor": "#b71c1c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 74,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• Dictionary form verbs & adjectives\n• Used with friends, family, juniors\n• Verb: 食べる | Adj: 高い | Copula: だ\n• の/ん explanatory: 食べるんだ",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Dictionary form verbs & adjectives\n• Used with friends, family, juniors\n• Verb: 食べる | Adj: 高い | Copula: だ\n• の/ん explanatory: 食べるんだ",
      "lineHeight": 1.25
    },
