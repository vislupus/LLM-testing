      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Core Principle: Japanese is SOV, left-branching, particle-driven, and context-dependent. Master particles + conjugation bases + politeness, and you master Japanese grammar.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Principle: Japanese is SOV, left-branching, particle-driven, and context-dependent. Master particles + conjugation bases + politeness, and you master Japanese grammar.",
      "lineHeight": 1.25
    },
