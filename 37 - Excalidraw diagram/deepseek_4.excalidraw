    },
    {
      "id": "verb-types-text",
      "type": "text",
      "x": 80,
      "y": 555,
      "width": 840,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1b5e20",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 43,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THREE VERB TYPES:\n📘 GODAN (五段) — ends in -u, conjugates across 5 vowel rows: 書く→書かない・書きます・書けば・書こう\n📗 ICHIDAN (一段) — ends in -iru/-eru, drops る: 食べる→食べない・食べます・食べれば・食べよう\n📙 IRREGULAR (不規則) — only する & 来る: する→しない・します・すれば・しよう",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THREE VERB TYPES:\n📘 GODAN (五段) — ends in -u, conjugates across 5 vowel rows: 書く→書かない・書きます・書けば・書こう\n📗 ICHIDAN (一段) — ends in -iru/-eru, drops る: 食べる→食べない・食べます・食べれば・食べよう\n📙 IRREGULAR (不規則) — only する & 来る: する→しない・します・すれば・しよう",
      "lineHeight": 1.25
    },
