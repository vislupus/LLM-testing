      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "💡 Japanese can drop any element that's clear from context. A complete sentence can be just a verb: 食べた。= \"(I) ate.\"",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "💡 Japanese can drop any element that's clear from context. A complete sentence can be just a verb: 食べた。= \"(I) ate.\"",
      "lineHeight": 1.25
    },
