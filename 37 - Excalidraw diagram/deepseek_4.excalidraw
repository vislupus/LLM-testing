      "locked": false,
      "text": "🟠 POLITE / TEINEI (丁寧語)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟠 POLITE / TEINEI (丁寧語)",
      "lineHeight": 1.25
    },
    {
      "id": "polite-teinei-content",
      "type": "text",
      "x": 530,
      "y": 1032,
      "width": 380,
      "height": 65,
      "angle": 0,
      "strokeColor": "#b71c1c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 77,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• 〜ます form (verbs), です (adj/nouns)\n• Default polite — strangers, coworkers\n• Verb: 食べます | Adj: 高いです | Copula: です\n• 〜ません negative: 食べません",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• 〜ます form (verbs), です (adj/nouns)\n• Default polite — strangers, coworkers\n• Verb: 食べます | Adj: 高いです | Copula: です\n• 〜ません negative: 食べません",
      "lineHeight": 1.25
    },
    {
